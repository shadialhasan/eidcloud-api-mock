#!/usr/bin/env php
<?php

declare(strict_types=1);

require_once __DIR__ . '/../src/autoload.php';

use EidCloud\ApiMock\MockServer;
use EidCloud\ApiMock\Parser\OpenApiParser;
use EidCloud\ApiMock\Simulator\ChaosSimulator;

$args = array_slice($argv, 1);

function showHelp(): void
{
    echo <<<HELP
\033[1;36m
  ____  _     _  ____ _                 _ 
 / ___|(_) __| |/ ___| | ___  _   _  __| |
| |__  | |/ _` | |   | |/ _ \| | | |/ _` |
|  __| | | (_| | |___| | (_) | |_| | (_| |
 \____|_|\__,_|\____|_|\___/ \__,_|\__,_|
      API Mock Server & Sandbox Engine v1.0.0
\033[0m
\033[1;33mUsage:\033[0m
  php bin/eidcloud-mock [command] [options] [arguments]

\033[1;33mCommands:\033[0m
  \033[1;32mserve\033[0m <spec-file>       Start real-time HTTP mock server
  \033[1;32mgenerate\033[0m <spec-file>    Pre-generate mock JSON fixtures for all endpoints
  \033[1;32mvalidate\033[0m <spec-file>    Parse and inspect OpenAPI/Swagger endpoints
  \033[1;32mhelp\033[0m, \033[1;32m--help\033[0m, \033[1;32m-h\033[0m        Display this assistance message

\033[1;33mOptions:\033[0m
  \033[1;37m--host=<host>\033[0m          Server bind address (default: 127.0.0.1)
  \033[1;37m--port=<port>\033[0m          Server bind port (default: 8080)
  \033[1;37m--delay=<ms>\033[0m           Simulate baseline latency in milliseconds (e.g. 150 or 200ms)
  \033[1;37m--error-rate=<pct>\033[0m     Simulate chaos error rate percentage (e.g. 15% or 0.15)
  \033[1;37m--out=<dir>\033[0m            Target output folder for generated fixtures (default: ./mock_data/)
  \033[1;37m--json\033[0m                 Output clean machine-readable JSON (useful for automated testing)

\033[1;33mExamples:\033[0m
  php bin/eidcloud-mock serve openapi.json --port=8080 --delay=150
  php bin/eidcloud-mock serve openapi.yaml --port=8080 --delay=200ms --error-rate=15%
  php bin/eidcloud-mock generate openapi.json --out=./mock_data/
  php bin/eidcloud-mock validate openapi.json --json

HELP;
}

if (empty($args) || in_array('--help', $args, true) || in_array('-h', $args, true) || in_array('help', $args, true)) {
    showHelp();
    exit(0);
}

// Parse command and options
$command = null;
$specFile = null;
$options = [
    'host' => '127.0.0.1',
    'port' => 8080,
    'delay' => 0,
    'error-rate' => 0.0,
    'out' => './mock_data/',
    'json' => false,
];

foreach ($args as $arg) {
    if (str_starts_with($arg, '--')) {
        $clean = substr($arg, 2);
        if (str_contains($clean, '=')) {
            [$key, $val] = explode('=', $clean, 2);
            if ($key === 'delay') {
                $val = (int) str_replace(['ms', 's'], ['', '000'], $val);
            } elseif ($key === 'error-rate') {
                if (str_ends_with($val, '%')) {
                    $val = ((float) rtrim($val, '%')) / 100.0;
                } else {
                    $val = (float) $val;
                }
            } elseif ($key === 'port') {
                $val = (int) $val;
            }
            $options[$key] = $val;
        } elseif ($clean === 'json') {
            $options['json'] = true;
        }
    } else {
        if ($command === null) {
            $command = $arg;
        } elseif ($specFile === null) {
            $specFile = $arg;
        }
    }
}

if ($command === null) {
    showHelp();
    exit(1);
}

// Validate command
if (!in_array($command, ['serve', 'generate', 'validate'], true)) {
    fprintf(STDERR, "\033[1;31mUnknown command:\033[0m %s\nRun 'php bin/eidcloud-mock --help' for usage.\n", $command);
    exit(1);
}

// Check spec file
if ($specFile === null) {
    fprintf(STDERR, "\033[1;31mError:\033[0m Missing specification file argument.\n");
    exit(1);
}

if (!file_exists($specFile)) {
    fprintf(STDERR, "\033[1;31mError:\033[0m Specification file '%s' does not exist.\n", $specFile);
    exit(1);
}

try {
    $parser = new OpenApiParser($specFile);
} catch (\Throwable $e) {
    fprintf(STDERR, "\033[1;31mParse Error:\033[0m %s\n", $e->getMessage());
    exit(1);
}

$endpoints = $parser->getEndpoints();

// COMMAND: validate
if ($command === 'validate') {
    if ($options['json']) {
        echo json_encode([
            'status' => 'valid',
            'version' => $parser->getVersion(),
            'endpoints_count' => count($endpoints),
            'endpoints' => array_map(fn($e) => ['method' => $e['method'], 'path' => $e['path'], 'summary' => $e['summary']], $endpoints)
        ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n";
    } else {
        echo "\033[1;32m✓ Specification is valid!\033[0m\n";
        echo "Format: " . $parser->getVersion() . "\n";
        echo "Found " . count($endpoints) . " endpoints:\n";
        foreach ($endpoints as $ep) {
            echo sprintf("  %-7s %-35s %s\n", $ep['method'], $ep['path'], $ep['summary'] ?: '');
        }
    }
    exit(0);
}

// COMMAND: generate
if ($command === 'generate') {
    $server = new MockServer($parser);
    $data = $server->generateStaticDataset();
    $outDir = rtrim($options['out'], '/\\') . '/';

    if (!is_dir($outDir)) {
        mkdir($outDir, 0777, true);
    }

    $manifest = [];
    foreach ($data as $routeKey => $payload) {
        [$m, $p] = explode(' ', $routeKey, 2);
        $cleanName = strtolower($m) . '_' . preg_replace('/[^a-zA-Z0-9_]/', '_', trim($p, '/'));
        if ($cleanName === strtolower($m) . '_') {
            $cleanName = strtolower($m) . '_root';
        }
        $fileName = $cleanName . '.json';
        file_put_contents($outDir . $fileName, json_encode($payload, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
        $manifest[$routeKey] = $fileName;
    }

    file_put_contents($outDir . 'manifest.json', json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));

    if ($options['json']) {
        echo json_encode([
            'status' => 'success',
            'out_dir' => $outDir,
            'generated_files' => count($manifest),
            'manifest' => $manifest
        ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n";
    } else {
        echo "\033[1;32m✓ Mock data fixtures generated successfully!\033[0m\n";
        echo "Output directory: {$outDir}\n";
        echo "Total endpoints generated: " . count($manifest) . "\n";
    }
    exit(0);
}

// COMMAND: serve
if ($command === 'serve') {
    $host = $options['host'];
    $port = (int) $options['port'];
    $delay = (int) $options['delay'];
    $errorRate = (float) $options['error-rate'];

    $routerPath = realpath(__DIR__ . '/../src/server_router.php');
    $realSpecPath = realpath($specFile);

    putenv("EIDCLOUD_MOCK_SPEC={$realSpecPath}");
    putenv("EIDCLOUD_MOCK_DELAY={$delay}");
    putenv("EIDCLOUD_MOCK_ERROR_RATE={$errorRate}");

    if ($options['json']) {
        echo json_encode([
            'status' => 'serving',
            'host' => $host,
            'port' => $port,
            'url' => "http://{$host}:{$port}",
            'spec' => $realSpecPath,
            'delay_ms' => $delay,
            'error_rate' => $errorRate,
            'endpoints_count' => count($endpoints)
        ], JSON_UNESCAPED_SLASHES) . "\n";
    } else {
        echo "\033[1;36m[EidCloud ApiMock]\033[0m Starting mock server...\n";
        echo "  • URL:        \033[1;32mhttp://{$host}:{$port}\033[0m\n";
        echo "  • Spec:       {$specFile} ({$parser->getVersion()})\n";
        echo "  • Endpoints:  " . count($endpoints) . "\n";
        echo "  • Latency:    {$delay}ms\n";
        echo "  • Chaos Rate: " . ($errorRate * 100) . "%\n";
        echo "Press Ctrl+C to stop.\n\n";
    }

    $cmd = sprintf('php -S %s:%d %s', escapeshellarg($host), $port, escapeshellarg($routerPath));
    passthru($cmd);
    exit(0);
}
